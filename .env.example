# ── Copy to .env and adjust ────────────────────────────────────────────────
# NEVER commit the real .env (it is git-ignored).

# --- core ---
ENV=dev
POSTGRES_DB=vsms
POSTGRES_PASSWORD=change-me-postgres
# Runtime role (non-owner, NOBYPASSRLS — RLS applies). Created by infra/postgres/init.
APP_DB_USER=app_user
APP_DB_PASSWORD=change-me-app

# --- auth ---
# openssl rand -hex 32
JWT_SECRET=change-me-64-hex-chars
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=14

# --- platform ---
# Tenants get <slug>.${PLATFORM_BASE_DOMAIN} and register custom domains here.
PLATFORM_BASE_DOMAIN=localhost
ACME_EMAIL=admin@example.com
CORS_ORIGINS=http://localhost:3000,http://localhost

# --- throttling (noisy-neighbor protection, per-tenant tokens/min by plan) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_FREE=60
RATE_LIMIT_PRO=300
RATE_LIMIT_ENTERPRISE=1200
LOGIN_RATE_PER_MINUTE=10

# --- BYOK envelope encryption (see docs/SECURITY.md) ---
# 32-byte key, base64. openssl rand -base64 32
MASTER_KEK_B64=change-me-base64-32-bytes
BYOK_ENABLED=false

# --- billing (provider-agnostic; stub works with no keys) ---
BILLING_PROVIDER=stub            # stub | paddle | stripe
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- geo / data residency (JSON map region -> asyncpg URL) ---
DEFAULT_REGION=eu
REGION_DATABASE_URLS={}

# --- observability ---
LOG_LEVEL=INFO
# OTEL_EXPORTER_OTLP_ENDPOINT=   # set to enable OTLP export when otel extras installed

# --- notifications ---
# SMS (Twilio-compatible). Empty = outbox rows record "skipped".
SMS_ACCOUNT_SID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=
# Email via SMTP. Host + From enable the channel; security is starttls|ssl|none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURITY=starttls

# --- frontend ---
NEXT_PUBLIC_APP_NAME=Vehicle Service Management
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost
# Public app base URL used in SMS links (e.g. review requests).
PUBLIC_APP_URL=http://localhost:3100
